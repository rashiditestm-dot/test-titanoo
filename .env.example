# Container example; Python does not load this file automatically.
# Copy to .env (ignored by Git), replace the password, then use Docker --env-file.
TITAN_ROLE=main
TITAN_DATA_DIR=/app/data
TITAN_ADMIN_USER=TiTaN
TITAN_ADMIN_PASS=replace-with-a-long-random-password
PORT=8000
PANEL_PORT=10000

# Nodes use their own persistent storage. Apply credentials from your panel.
# TITAN_ROLE=node
# TITAN_NODE_NAME=Amsterdam-01
# TITAN_NODE_URL=https://node.example.com
# TITAN_MAIN_URL=https://panel.example.com
# TITAN_NODE_TOKEN=issued-by-your-main-panel

# Alternative preconfigured fleet credential (same value on main and nodes):
# TITAN_NODE_SECRET=replace-with-a-long-random-shared-secret
